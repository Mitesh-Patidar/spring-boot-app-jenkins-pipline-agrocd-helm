pipeline {
  agent jenkins-agent
  
  environment {
    IMAGE_NAME = 'springboot-app'
    IMAGE_TAG = 'v1'
  }

  stages {
    stage ('Git Checkout') {
      steps {
        git_url: 'https://github.com/Mitesh-Patidar/spring-boot-app-jenkins-pipline-agrocd-helm.git', branch: 'main'
       }
    }

    stage ('Build with Maven') {
      steps {
        sh 'mvn clean package -DskipTests'
      }
    }
 
    stage ('Build Docker Image') {
      steps {
         sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
      }
    }
  }
}
